<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.pay</groupId>
        <artifactId>pay-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>payment-web</artifactId>
    <name>payment-web</name>
    <packaging>jar</packaging>

    <properties>
        <start-class>com.pay.web.PaymentApplication</start-class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-wechat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-alipay</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-paypal</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-apple</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-tonglian</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.pay</groupId>
            <artifactId>payment-provider-lakala</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.6.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
